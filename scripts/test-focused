#!/usr/bin/env bash
# Run a single focused test class (or method) against the floci test suite.
#
# Usage:
#   scripts/test-focused KmsIntegrationTest
#   scripts/test-focused KmsServiceTest#rsaEncryptDecryptRoundTrip
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: $0 <TestClass[#method]> [extra mvn args...]" >&2
  exit 2
fi

TEST_SELECTOR="$1"
shift

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec "$ROOT/mvnw" test -Dtest="$TEST_SELECTOR" "$@"
